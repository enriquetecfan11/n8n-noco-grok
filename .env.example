# ==========================================
# n8n-noco-grok · environment template
# ==========================================
# Copy this file to .env and replace every secret/placeholder before starting.

# ------------------------------------------
# Database
# ------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# ------------------------------------------
# n8n core
# ------------------------------------------
N8N_VERSION=latest
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=
TIMEZONE=Europe/Madrid

# Optional basic auth. n8n user management is normally preferred.
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ------------------------------------------
# Public URL and Ngrok
# ------------------------------------------
# Must match the public HTTPS endpoint configured in your local ngrok.yml.
WEBHOOK_URL=https://your-subdomain.ngrok-free.app
NGROK_TOKEN=

# ------------------------------------------
# n8n Assistant · official n8n sandbox
# ------------------------------------------
N8N_ENABLED_MODULES=instance-ai
# Model provider, API key and model: configure them in n8n > Settings > AI Assistant.
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# ------------------------------------------
# Official n8n sandbox service
# ------------------------------------------
N8N_SANDBOX_VERSION=1.3.4
N8N_RUNNERS_AUTH_TOKEN=

# Use unique random values for all sandbox secrets.
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=

# Must match a value in SANDBOX_API_KEYS.
N8N_SANDBOX_SERVICE_API_KEY=

# ------------------------------------------
# Web search · bundled SearXNG
# ------------------------------------------
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# Optional: Brave takes priority over SearXNG when configured.
INSTANCE_AI_BRAVE_SEARCH_API_KEY=

# ------------------------------------------
# Optional agents module
# ------------------------------------------
# N8N_ENABLED_MODULES=instance-ai,agents
